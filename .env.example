# =============================================================
# Agri LMS — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================

# Flask
FLASK_APP=run.py
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=replace-with-very-long-random-secret-key

# PostgreSQL
DATABASE_URL=postgresql://username:password@localhost:5432/agri_lms_db

# App
APP_NAME=Agri Learning Platform
ADMIN_EMAIL=admin@agrilms.com

# Uploads
MAX_UPLOAD_MB=100
UPLOAD_FOLDER=app/static/uploads